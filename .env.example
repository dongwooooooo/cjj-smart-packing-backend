POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# RDS 를 쓰는 환경(EC2)에서만. 로컬은 이 네 줄을 두지 않는다 — override 의 db 컨테이너를 쓴다.
# COMPOSE_FILE 이 docker-compose.override.yml(로컬 db)을 제외하고, HOST 는 RDS 엔드포인트다.
#COMPOSE_FILE=docker-compose.yml
#POSTGRES_HOST=database-1.xxxx.ap-northeast-2.rds.amazonaws.com
#POSTGRES_USER=postgres
#POSTGRES_DB=postgres

# 비워두면 백엔드가 mock 추론 응답을 반환한다 (D-04).
# 실연동은 Lambda 함수명:별칭 — EC2 인스턴스 프로파일로 호출하므로 AWS 키는 넣지 않는다 (D-23)
INFERENCE_LAMBDA_FUNCTION=
# 함수 환경변수 API_KEY 와 같은 값 (X-API-Key)
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_SECONDS=8

# 이미지 버킷 (D-25). 비우면 로컬 ./demo/data 에 두고 서버가 직접 서빙한다.
# EC2 인스턴스 프로파일로 접근하므로 AWS 키는 넣지 않는다.
STORAGE_BUCKET=
